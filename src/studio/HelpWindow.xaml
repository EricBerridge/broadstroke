<?xml version="1.0" encoding="utf-8"?>
<!-- The help window (spec 2.10): the topics beside the open page. -->
<Window
    x:Class="BroadstrokeStudio.HelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Broadstroke Help">
  <Grid x:Name="root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
    </Grid.KeyboardAccelerators>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="270" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <ListView x:Name="topics" Margin="6,10,6,10" SelectionMode="Single" SelectionChanged="OnTopicChanged" />
    <ScrollViewer x:Name="scroller" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <RichTextBlock x:Name="page" Margin="24,18,24,18" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
    </ScrollViewer>
  </Grid>
</Window>
