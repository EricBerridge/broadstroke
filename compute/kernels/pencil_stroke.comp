#version 450

// Per-pixel pencil stroke deposition.
//
// One thread per output pixel. The thread iterates every segment of the
// supplied polyline, finds its closest point on the segment, weights
// the contribution by stamp falloff and the substrate's tooth, and
// accumulates into a single "total_deposit" scalar. The accumulated
// value drives an exponential saturation update on the graphite layer.
//
// Bounded-box dispatch (Stage 4): pixel = invocation + (offset_x,
// offset_y). For full-canvas dispatch, offset = (0, 0). For an AABB
// dispatch, offset = stroke's xmin/ymin and the dispatch size matches
// the AABB extent — a >100x speedup for short strokes on large canvases.
//
// Bindings:
//   0: RW graphite density   (W*H floats, [0, 1])
//   1: RO tooth              (W*H floats)
//   2: RO stroke             (3 * num_points floats: x, y, pressure)
//   3: RO params
//
// Params:
//   p[0..1] = canvas_width, canvas_height
//   p[2]    = num_points (>= 2)
//   p[3]    = tip_radius_px
//   p[4]    = tip_softness
//   p[5]    = deposit_strength
//   p[6..7] = offset_x, offset_y

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 16
#endif
#ifndef LOCAL_SIZE_Y
#define LOCAL_SIZE_Y 16
#endif

layout(local_size_x = LOCAL_SIZE_X, local_size_y = LOCAL_SIZE_Y, local_size_z = 1) in;

layout(std430, set = 0, binding = 0)          buffer Graphite  { float graphite[]; };
layout(std430, set = 0, binding = 1) readonly buffer Tooth     { float tooth[]; };
layout(std430, set = 0, binding = 2) readonly buffer StrokeBuf { float stroke[]; };
layout(std430, set = 0, binding = 3) readonly buffer Params    { float p[]; };

void main() {
  uint width  = uint(p[0]);
  uint height = uint(p[1]);
  uint x = gl_GlobalInvocationID.x + uint(p[6]);
  uint y = gl_GlobalInvocationID.y + uint(p[7]);
  if (x >= width || y >= height) return;

  uint num_points = uint(p[2]);
  if (num_points < 2u) return;

  float tip_radius       = p[3];
  float tip_softness     = p[4];
  float deposit_strength = p[5];

  uint  i      = y * width + x;
  vec2  pixel  = vec2(float(x) + 0.5, float(y) + 0.5);
  float tooth_here = 0.16 + 0.90 * tooth[i];

  float band = max(0.01, tip_softness * tip_radius);

  float total_deposit = 0.0;

  for (uint s = 0u; s + 1u < num_points; ++s) {
    uint i0 = s * 3u;
    uint i1 = (s + 1u) * 3u;
    vec2  a = vec2(stroke[i0 + 0u], stroke[i0 + 1u]);
    vec2  b = vec2(stroke[i1 + 0u], stroke[i1 + 1u]);
    float pa = stroke[i0 + 2u];
    float pb = stroke[i1 + 2u];

    vec2 ab = b - a;
    float len_sq = dot(ab, ab);
    float t = (len_sq > 1e-8) ? clamp(dot(pixel - a, ab) / len_sq, 0.0, 1.0)
                              : 0.0;
    vec2  closest = a + t * ab;
    float dist    = length(pixel - closest);
    if (dist >= tip_radius) continue;

    float u = clamp((tip_radius - dist) / band, 0.0, 1.0);
    float falloff = u * u * (3.0 - 2.0 * u);

    float pressure = mix(pa, pb, t);
    total_deposit += pressure * falloff * tooth_here * deposit_strength;
  }

  float prev = graphite[i];
  graphite[i] = 1.0 - (1.0 - prev) * exp(-total_deposit);
}
