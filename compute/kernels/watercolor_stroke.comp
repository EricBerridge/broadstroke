#version 450

// Wet brush deposition. Same per-pixel-walks-segments structure as
// pencil_stroke, but writes into TWO fields:
//   * wetness — saturated water content [0, ~1+] (clamped at compose)
//   * pigment — concentration of suspended pigment, [0, ~3+]
//
// Pigment deposit is gated by tooth (the brush prefers paper grain that
// catches water) and modulated by pressure × falloff, like pencil. Water
// is deposited proportionally to pressure × falloff, no tooth gate (water
// fills valleys regardless of grain).
//
// Bounded-box dispatch: pixel coord = invocation + (offset_x, offset_y).
// For a full-canvas dispatch, offset is (0, 0) and dispatch size = (W, H).
// For Stage 4 stroke-AABB dispatch, the offset is the stroke's xmin/ymin
// and dispatch size is the AABB extent, which can be a >100x speedup for
// short strokes on a large canvas.
//
// Bindings:
//   0: RW pigment        (W*H floats)
//   1: RW wetness        (W*H floats)
//   2: RO tooth          (W*H floats)
//   3: RO stroke         (3 * num_points floats: x, y, pressure)
//   4: RO params
//
// Params:
//   p[0..1]   = canvas_width, canvas_height          (full canvas)
//   p[2]      = num_points (>= 2)
//   p[3]      = tip_radius_px
//   p[4]      = tip_softness
//   p[5]      = water_load
//   p[6]      = pigment_load
//   p[7..8]   = offset_x, offset_y                   (bounded-box)

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0)          buffer Pigment   { float pigment[]; };
layout(std430, set = 0, binding = 1)          buffer Wetness   { float wetness[]; };
layout(std430, set = 0, binding = 2) readonly buffer Tooth     { float tooth[]; };
layout(std430, set = 0, binding = 3) readonly buffer StrokeBuf { float stroke[]; };
layout(std430, set = 0, binding = 4) readonly buffer Params    { float p[]; };

void main() {
  uint width  = uint(p[0]);
  uint height = uint(p[1]);
  uint x = gl_GlobalInvocationID.x + uint(p[7]);
  uint y = gl_GlobalInvocationID.y + uint(p[8]);
  if (x >= width || y >= height) return;

  uint num_points = uint(p[2]);
  if (num_points < 2u) return;

  float tip_radius   = p[3];
  float tip_softness = p[4];
  float water_load   = p[5];
  float pigment_load = p[6];

  uint  i      = y * width + x;
  vec2  pixel  = vec2(float(x) + 0.5, float(y) + 0.5);
  float tooth_here = tooth[i];

  float band = max(0.01, tip_softness * tip_radius);

  float total_water   = 0.0;
  float total_pigment = 0.0;

  for (uint s = 0u; s + 1u < num_points; ++s) {
    uint i0 = s * 3u;
    uint i1 = (s + 1u) * 3u;
    vec2  a  = vec2(stroke[i0 + 0u], stroke[i0 + 1u]);
    vec2  b  = vec2(stroke[i1 + 0u], stroke[i1 + 1u]);
    float pa = stroke[i0 + 2u];
    float pb = stroke[i1 + 2u];

    vec2 ab = b - a;
    float len_sq = dot(ab, ab);
    float t = (len_sq > 1e-8) ? clamp(dot(pixel - a, ab) / len_sq, 0.0, 1.0)
                              : 0.0;
    vec2  closest = a + t * ab;
    float dist    = length(pixel - closest);
    if (dist >= tip_radius) continue;

    float u = clamp((tip_radius - dist) / band, 0.0, 1.0);
    float falloff = u * u * (3.0 - 2.0 * u);
    float pressure = mix(pa, pb, t);

    total_water   += pressure * falloff * water_load;
    // Pigment deposition prefers tooth: a 0.5 + 0.5*tooth weighting
    // ensures even smooth bristol picks up some pigment, while cold-press
    // catches noticeably more — matching the wet-brush observation that
    // toothed papers grab pigment harder.
    total_pigment += pressure * falloff * pigment_load * (0.5 + 0.5 * tooth_here);
  }

  // Wetness saturates additively but is capped to keep diffusion stable.
  wetness[i] = min(wetness[i] + total_water, 4.0);
  // Pigment accumulates without cap — KM thickness handles visual saturation.
  pigment[i] = pigment[i] + total_pigment;
}
