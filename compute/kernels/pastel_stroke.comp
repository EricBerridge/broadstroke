#version 450

// Dry-pigment stroke (pastel, charcoal). Same per-pixel/all-segments
// shape as pencil_stroke, but writes into a pigment field (rendered via
// apply_pigment / KM) instead of a graphite density field. No exponential
// saturation — pastel deposit accumulates additively and KM thickness is
// what saturates color visually.
//
// Bindings:
//   0: RW pigment        (W*H floats)
//   1: RO tooth
//   2: RO stroke
//   3: RO params
//
// Params (same shape as pencil_stroke for symmetry):
//   p[0..1] = canvas_width, canvas_height
//   p[2]    = num_points
//   p[3]    = tip_radius_px
//   p[4]    = tip_softness
//   p[5]    = deposit_strength      (concentration per unit pressure*tooth*arc)
//   p[6..7] = offset_x, offset_y

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0)          buffer Pigment   { float pigment[]; };
layout(std430, set = 0, binding = 1) readonly buffer Tooth     { float tooth[]; };
layout(std430, set = 0, binding = 2) readonly buffer StrokeBuf { float stroke[]; };
layout(std430, set = 0, binding = 3) readonly buffer Params    { float p[]; };

void main() {
  uint width  = uint(p[0]);
  uint height = uint(p[1]);
  uint x = gl_GlobalInvocationID.x + uint(p[6]);
  uint y = gl_GlobalInvocationID.y + uint(p[7]);
  if (x >= width || y >= height) return;

  uint num_points = uint(p[2]);
  if (num_points < 2u) return;

  float tip_radius       = p[3];
  float tip_softness     = p[4];
  float deposit_strength = p[5];

  uint  i = y * width + x;
  vec2  pixel = vec2(float(x) + 0.5, float(y) + 0.5);
  float tooth_here = tooth[i];
  float band = max(0.01, tip_softness * tip_radius);

  float total_deposit = 0.0;

  for (uint s = 0u; s + 1u < num_points; ++s) {
    uint i0 = s * 3u;
    uint i1 = (s + 1u) * 3u;
    vec2  a = vec2(stroke[i0 + 0u], stroke[i0 + 1u]);
    vec2  b = vec2(stroke[i1 + 0u], stroke[i1 + 1u]);
    float pa = stroke[i0 + 2u];
    float pb = stroke[i1 + 2u];

    vec2 ab = b - a;
    float len_sq = dot(ab, ab);
    float t = (len_sq > 1e-8) ? clamp(dot(pixel - a, ab) / len_sq, 0.0, 1.0)
                              : 0.0;
    vec2  closest = a + t * ab;
    float dist    = length(pixel - closest);
    if (dist >= tip_radius) continue;

    float u = clamp((tip_radius - dist) / band, 0.0, 1.0);
    float falloff = u * u * (3.0 - 2.0 * u);
    float pressure = mix(pa, pb, t);

    // Pastel deposits more on toothed papers (the chalky particles catch
    // on grain). 0.4 + 0.6*tooth shifts the curve harder on tooth than
    // watercolor's 0.5+0.5, matching how pastels really skip on bristol.
    total_deposit += pressure * falloff * deposit_strength *
                     (0.4 + 0.6 * tooth_here);
  }

  pigment[i] = pigment[i] + total_deposit;
}
