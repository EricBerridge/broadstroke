#version 450

// Composite a pigment layer onto an existing RGBA buffer using Kubelka-
// Munk per-channel. Each pigment carries absorption (K) and scattering
// (S) coefficients sampled at three wavelengths. The per-pixel
// concentration scales both, then we derive:
//
//   R_inf  = body color of an infinitely thick film (KM closed form)
//   T      = transmittance through a film of optical thickness ~ c
//   result = R_inf * (1 - T) + substrate * T
//
// Thin layer → T~1 → substrate dominates (transparent wash).
// Thick layer → T~0 → R_inf dominates (opaque body color).
//
// Bindings:
//   0: RW rgba         (W*H*4 floats)
//   1: RO pigment      (W*H floats — concentration in [0, ~3])
//   2: RO params
//
// Params:
//   p[0..1] = width, height
//   p[2..4] = pigment K rgb
//   p[5..7] = pigment S rgb
//   p[8]    = thickness_scale  (multiplies (K+S)*c in the transmittance)

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0)          buffer Rgba    { float rgba[]; };
layout(std430, set = 0, binding = 1) readonly buffer Pigment { float pigment[]; };
layout(std430, set = 0, binding = 2) readonly buffer Params  { float p[]; };

void main() {
  uint x = gl_GlobalInvocationID.x;
  uint y = gl_GlobalInvocationID.y;
  uint width  = uint(p[0]);
  uint height = uint(p[1]);
  if (x >= width || y >= height) return;

  vec3  K      = vec3(p[2], p[3], p[4]);
  vec3  S      = vec3(p[5], p[6], p[7]);
  float tscale = p[8];

  uint  i  = y * width + x;
  uint  ix = i * 4u;
  float c  = max(pigment[i], 0.0);
  if (c <= 0.0) return;  // no paint here, skip the cost

  // Per-channel KM. epsilon on S keeps the divide finite when S is tiny.
  vec3 Keff = K * c;
  vec3 Seff = S * c + vec3(1e-4);
  vec3 ratio = Keff / Seff;
  vec3 root  = sqrt(ratio * ratio + 2.0 * ratio);
  vec3 R_inf = vec3(1.0) + ratio - root;

  // Extinction over the layer; thickness ~ concentration. Both K and S
  // attenuate transmitted light (S scatters it back, K absorbs it).
  vec3 extinction = (Keff + Seff) * tscale;
  vec3 T = exp(-extinction);

  vec3 prev = vec3(rgba[ix + 0u], rgba[ix + 1u], rgba[ix + 2u]);
  vec3 mixed = R_inf * (vec3(1.0) - T) + prev * T;

  rgba[ix + 0u] = mixed.r;
  rgba[ix + 1u] = mixed.g;
  rgba[ix + 2u] = mixed.b;
}
