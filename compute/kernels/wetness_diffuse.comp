#version 450

// One reaction-diffusion timestep on the wetness + suspended-pigment
// fields. Ping-pong: reads from in_*, writes to out_*. The host runs N
// substeps (typically 4-16 between strokes) by swapping the buffer roles.
//
//   wetness   diffuses freely, gated by 4-neighbor Laplacian.
//   pigment   diffuses by the same Laplacian, but the rate is scaled by
//             the *minimum* of local wetness and average neighbor wetness:
//             a dry cell can't pull pigment in, and a wet cell can't push
//             pigment into a dry one. This is what produces the
//             characteristic hard-edge / dry-edge distinction in real
//             watercolor.
//   wetness   shrinks each step by absorption[i] * dry_rate * dt — the
//             paper soaks up water at a per-pixel rate.
//
// Bounded-box dispatch like watercolor_stroke: invocation + (off_x, off_y).
//
// Bindings:
//   0: RO pigment_in
//   1: WO pigment_out
//   2: RO wetness_in
//   3: WO wetness_out
//   4: RO absorption
//   5: RO params
//
// Params:
//   p[0..1] = width, height
//   p[2]    = water_diffusion   (typical 0.20)
//   p[3]    = pigment_diffusion (typical 0.18)
//   p[4]    = dry_rate          (typical 0.08)
//   p[5]    = dt                (typical 1.0; tunes effective step size)
//   p[6..7] = offset_x, offset_y

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly  buffer PIn  { float pin[]; };
layout(std430, set = 0, binding = 1) writeonly buffer POut { float pout[]; };
layout(std430, set = 0, binding = 2) readonly  buffer WIn  { float win[]; };
layout(std430, set = 0, binding = 3) writeonly buffer WOut { float wout[]; };
layout(std430, set = 0, binding = 4) readonly  buffer Abs  { float absorption[]; };
layout(std430, set = 0, binding = 5) readonly  buffer Params { float p[]; };

void main() {
  uint width  = uint(p[0]);
  uint height = uint(p[1]);
  uint x = gl_GlobalInvocationID.x + uint(p[6]);
  uint y = gl_GlobalInvocationID.y + uint(p[7]);
  if (x >= width || y >= height) return;

  float water_diff   = p[2];
  float pigment_diff = p[3];
  float dry_rate     = p[4];
  float dt           = p[5];

  uint xm = (x == 0)           ? 0          : x - 1;
  uint xp = (x + 1 >= width)   ? width - 1  : x + 1;
  uint ym = (y == 0)           ? 0          : y - 1;
  uint yp = (y + 1 >= height)  ? height - 1 : y + 1;

  uint i  = y * width + x;
  uint iL = y  * width + xm;
  uint iR = y  * width + xp;
  uint iD = ym * width + x;
  uint iU = yp * width + x;

  float w_here = win[i];
  float w_L = win[iL]; float w_R = win[iR];
  float w_D = win[iD]; float w_U = win[iU];
  float lap_w = (w_L + w_R + w_D + w_U) - 4.0 * w_here;

  float p_here = pin[i];
  float p_L = pin[iL]; float p_R = pin[iR];
  float p_D = pin[iD]; float p_U = pin[iU];
  float lap_p = (p_L + p_R + p_D + p_U) - 4.0 * p_here;

  // Pigment can only move where water is. The min/avg gate is what makes
  // pigment stop dead at dry edges and accumulate (the granulation /
  // hard-edge effect of dried watercolor).
  float avg_neighbor_w = 0.25 * (w_L + w_R + w_D + w_U);
  float carrier = clamp(min(w_here, avg_neighbor_w), 0.0, 1.0);

  float new_w = w_here + dt * water_diff   * lap_w
                       - dt * dry_rate     * absorption[i];
  float new_p = p_here + dt * pigment_diff * carrier * lap_p;

  wout[i] = max(new_w, 0.0);
  pout[i] = max(new_p, 0.0);
}
