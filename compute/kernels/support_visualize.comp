#version 450

// Renders the support heightfield to RGBA under raking light. Output is
// linear-space float [0, 1] per channel; the host tonemaps to sRGB/8-bit
// at write time.
//
// Bindings:
//   0: readonly heightfield   (width*height floats)
//   1: writeonly rgba         (width*height*4 floats; pixel-major)
//   2: readonly params        (packed scalars; layout below)
//
// Params layout (floats):
//   p[0] = width    (cast to uint)
//   p[1] = height   (cast to uint)
//   p[2..4] = base_color rgb
//   p[5..7] = light direction (pre-normalized)
//   p[8] = ambient term in [0, 1]
//   p[9] = height_scale — amplifies finite-difference gradient

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Heightfield {
  float heightfield[];
};

layout(std430, set = 0, binding = 1) writeonly buffer OutputRgba {
  float rgba[];
};

layout(std430, set = 0, binding = 2) readonly buffer Params {
  float p[];
};

void main() {
  uint x = gl_GlobalInvocationID.x;
  uint y = gl_GlobalInvocationID.y;
  uint width  = uint(p[0]);
  uint height = uint(p[1]);
  if (x >= width || y >= height) return;

  vec3  base_color   = vec3(p[2], p[3], p[4]);
  vec3  light_dir    = vec3(p[5], p[6], p[7]);
  float ambient      = p[8];
  float height_scale = p[9];

  // Edge-clamped neighbor sampling.
  uint xm = (x == 0)            ? 0          : x - 1;
  uint xp = (x + 1 >= width)    ? width - 1  : x + 1;
  uint ym = (y == 0)            ? 0          : y - 1;
  uint yp = (y + 1 >= height)   ? height - 1 : y + 1;

  float h_left  = heightfield[y  * width + xm];
  float h_right = heightfield[y  * width + xp];
  float h_down  = heightfield[ym * width + x ];
  float h_up    = heightfield[yp * width + x ];

  // Central differences; scaled to dial relief strength.
  float gx = (h_right - h_left) * 0.5 * height_scale;
  float gy = (h_up    - h_down) * 0.5 * height_scale;
  vec3 normal = normalize(vec3(-gx, -gy, 1.0));

  float diffuse = max(0.0, dot(normal, light_dir));
  float shading = ambient + (1.0 - ambient) * diffuse;
  vec3 color = base_color * shading;

  uint idx = (y * width + x) * 4u;
  rgba[idx + 0u] = color.r;
  rgba[idx + 1u] = color.g;
  rgba[idx + 2u] = color.b;
  rgba[idx + 3u] = 1.0;
}
