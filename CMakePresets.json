{
  "version": 4,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-release",
      "displayName": "MSVC - Release",
      "binaryDir": "${sourceDir}/build/msvc-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "msvc-profile",
      "displayName": "MSVC - Release with symbols (for profiling)",
      "binaryDir": "${sourceDir}/build/msvc-profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /Ob2 /DNDEBUG /Zi",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/DEBUG /OPT:REF /OPT:ICF /INCREMENTAL:NO"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC - Debug",
      "binaryDir": "${sourceDir}/build/msvc-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja - Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja - Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "msvc-release", "configuration": "Release" },
    { "name": "debug", "configurePreset": "msvc-debug", "configuration": "Debug" },
    { "name": "profile", "configurePreset": "msvc-profile", "configuration": "Release" },
    { "name": "ninja-release", "configurePreset": "ninja-release" },
    { "name": "ninja-debug", "configurePreset": "ninja-debug" }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "msvc-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug",
      "configurePreset": "msvc-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
